# Register plugin with firmware (needed for pkg install outside of the UI)
REGISTER="/usr/local/opnsense/scripts/firmware/register.php"
VERSION_INFO="/usr/local/opnsense/version/kea-ddns"
if [ -f "$REGISTER" ] && [ -f "$VERSION_INFO" ]; then
    PLUGIN_ID=$(sed -n 's/.*"product_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VERSION_INFO")
    if [ -n "$PLUGIN_ID" ]; then
        $REGISTER install "$PLUGIN_ID"
    fi
fi

# Add banzai-plugins pkg repos with signature verification
SERIES=$(opnsense-version -a 2>/dev/null || echo "26.1")

REPO_CONF="/usr/local/etc/pkg/repos/banzai-plugins.conf"
if [ ! -f "$REPO_CONF" ]; then
    cat > "$REPO_CONF" <<REPOEOF
banzai-plugins: {
  url: "https://brendanbank.github.io/banzai-plugins/\${ABI}/${SERIES}/repo",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/etc/pkg/fingerprints/banzai-plugins",
  enabled: yes
}
REPOEOF
fi

# Dev repo for -devel packages (disabled by default)
DEV_REPO_CONF="/usr/local/etc/pkg/repos/banzai-plugins-dev.conf"
if [ ! -f "$DEV_REPO_CONF" ]; then
    cat > "$DEV_REPO_CONF" <<REPOEOF
banzai-plugins-dev: {
  url: "https://brendanbank.github.io/banzai-plugins/\${ABI}/${SERIES}/dev/repo",
  signature_type: "fingerprints",
  fingerprints: "/usr/local/etc/pkg/fingerprints/banzai-plugins",
  enabled: no
}
REPOEOF
fi

# Self-heal: keep the repo series in sync with the running OPNsense series
# after a major upgrade. pkg resolves ${ABI} at runtime but has no variable
# for the OPNsense series, so the series is baked into the URL at install time
# and would otherwise point at a non-existent path after an upgrade (e.g.
# FreeBSD:15:amd64/26.1). The reconcile hook is installed into the boot (start)
# and firmware (update, upgrade) syshook levels so it runs at every boot and
# during firmware operations. It MUST exit 0 — a failing upgrade hook aborts
# the OPNsense upgrade. Written at runtime like the repo conf above, so any
# banzai plugin can drop it without pkg file-ownership conflicts.
RECONCILE_SRC=$(mktemp)
cat > "$RECONCILE_SRC" <<'RECEOF'
#!/bin/sh
# Reconcile the banzai-plugins pkg repo series with the running OPNsense
# series. The repo URL embeds the series (pkg cannot resolve it), so after a
# major OPNsense upgrade the conf keeps the old series. Always exits 0 so it
# is safe as a firmware upgrade hook.
SERIES=$(opnsense-version -a 2>/dev/null)
[ -n "$SERIES" ] || exit 0
for f in /usr/local/etc/pkg/repos/banzai-plugins.conf \
         /usr/local/etc/pkg/repos/banzai-plugins-dev.conf; do
    [ -f "$f" ] || continue
    cur=$(sed -n 's#.*banzai-plugins/[^/]*/\([0-9][0-9]*\.[0-9][0-9]*\)/.*#\1#p' "$f" | head -1)
    if [ -n "$cur" ] && [ "$cur" != "$SERIES" ]; then
        sed -i '' "s#/${cur}/#/${SERIES}/#g" "$f"
        logger -t banzai-plugins "repo series reconciled ${cur} -> ${SERIES} in $(basename "$f")"
    fi
done
exit 0
RECEOF
for _hl in start update upgrade; do
    _hd="/usr/local/etc/rc.syshook.d/${_hl}"
    mkdir -p "$_hd"
    install -m 0755 "$RECONCILE_SRC" "${_hd}/50-banzai-plugins-repo"
done
rm -f "$RECONCILE_SRC"
# Run once now so an install right after a major upgrade fixes a stale series.
/usr/local/etc/rc.syshook.d/start/50-banzai-plugins-repo 2>/dev/null || :

# One-time cleanup: note if old core patch is still present (harmless)
KEA_INC="/usr/local/etc/inc/plugins.inc.d/kea.inc"
if grep -q 'kea_ddns_generate' "$KEA_INC" 2>/dev/null; then
    echo "NOTE: Old kea-ddns core patch detected in kea.inc."
    echo "      It is harmless and will be removed by the next OPNsense update."
    echo "      kea-ddns 2.0 no longer requires core patches."
fi

# Restart configd to pick up new kea_ddns.inc, then reconfigure Kea
# so kea_ddns_configure_do() applies the DDNS overlay
/usr/local/etc/rc.d/configd restart
configctl kea reconfigure >/dev/null 2>&1 || :
configctl kea restart >/dev/null 2>&1 || :
